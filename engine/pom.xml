<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it.spaghettisource.tigersupply</groupId>
        <artifactId>tigersupply</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>engine</artifactId>
    <name>TigerSupply Engine</name>

    <dependencies>

        <!--
            MP3 decoding via the JavaZoom MP3SPI provider. It registers javax.sound.sampled SPI
            services so AudioSystem.getAudioInputStream() decodes MP3 transparently, keeping a single
            playback path for WAV and MP3. Pulls jlayer and tritonus-share transitively.
            Deliberate, documented exception to the project's "zero external runtime dependencies"
            convention: the JDK cannot decode MP3 without a third-party decoder.
        -->
        <dependency>
            <groupId>com.googlecode.soundlibs</groupId>
            <artifactId>mp3spi</artifactId>
            <version>1.9.5.4</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>